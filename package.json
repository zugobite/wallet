{
  "name": "wallet",
  "version": "1.5.0",
  "description": "A secure, production-ready wallet transaction API with two-phase debit authorization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zugobite/wallet.git"
  },
  "author": "Zugobite",
  "bugs": {
    "url": "https://github.com/zugobite/wallet/issues"
  },
  "homepage": "https://github.com/zugobite/wallet#readme",
  "type": "module",
  "main": "src/app.mjs",
  "scripts": {
    "dev": "node src/app.mjs",
    "start": "node src/app.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{js,mjs}'",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "~7.6.0",
    "@prisma/client": "~7.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.1",
    "cors": "^2.8.6",
    "express": "~4.22.1",
    "express-rate-limit": "^8.3.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.8.2",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "~3.5.2",
    "monetra": "^2.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0",
    "serverless-http": "~4.0.0",
    "swagger-jsdoc": "~6.2.8",
    "swagger-ui-express": "~5.0.1",
    "ua-parser-js": "^2.0.9",

    "uuid": "~13.0.0",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "~9.6.0",
    "@stryker-mutator/vitest-runner": "~9.6.0",
    "@vitest/coverage-v8": "~4.1.2",
    "dotenv": "~17.3.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "prisma": "~7.6.0",
    "supertest": "~7.2.2",
    "vitest": "~4.1.2"
  }
}
